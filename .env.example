# AI Medical Assistant (AMA) Configuration Template
# Copy to .env and adjust values for your environment.

# Server Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1
SECRET_KEY=ama-change-me-locally-generated-secure-key-32-chars

# Local Storage & Database
DATABASE_PATH=backend/database/ama_local.sqlite
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=16

# Privacy & Retention
ENABLE_HISTORY_LOGGING=1
AUTO_PURGE_UPLOADS=1

# Tesseract OCR Windows Configuration
# Typical Windows path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# Model Execution Mode: auto | cpu | cuda
TORCH_DEVICE=auto

# Optional API Keys (Not required for local-first operation)
# GEMINI_API_KEY=""
