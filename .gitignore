# Python virtual environments & bytecode
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Local databases and temporary uploads
*.sqlite
*.sqlite3
*.db
backend/database/ama_local.sqlite
uploads/
temp_audio/
temp_images/
temp_docs/

# Model checkpoints and weights (>50MB not committed to Git)
model_artifacts/weights/*.pth
model_artifacts/weights/*.pt
model_artifacts/weights/*.onnx
model_artifacts/weights/*.bin
!model_artifacts/weights/.gitkeep

# Large datasets (>100MB)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Environment variables & secrets
.env
.env.local

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

